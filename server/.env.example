# Copy this file to .env and fill in your own values. Never commit .env.

# Secret used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-long-random-string

# Google Gemini API key from https://aistudio.google.com (free tier available).
# Leave blank to use mock AI responses.
GEMINI_API_KEY=your-gemini-api-key

# Gemini model used for drafting answers. Defaults to gemini-3.8-flash if blank.
GEMINI_MODEL=gemini-3.8-flash

# Set to true to skip the Gemini API and return sample drafts (no key or quota needed).
AI_MOCK=true
